CC = @CC@
CFLAGS = @CFLAGS@ @FEATURE_CFLAGS@ @OPENMP_CFLAGS@ -w -std=gnu89 -fcommon
LIBS = @LIBS@

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@

prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@

SRCDIR := src
BINDIR := bin

TESTOPT=-S60 -C80 -V.6 -ao0.8
#TESTOPT=-S60 -C80 -V.6 -ao0.8 -Cl.2
#TESTOPT=-S60 -C80 -V.6 -ao0.8 -Omincutcnt=2

OBJNAMES := domclust.o util.o graph.o memalloc.o namehash.o hash.o \
	cluster.o clustout.o collectclust.o vararray.o plist.o bin.o seqreg.o \
	spec.o sptree.o domain.o readfile.o dump.o neighbor.o \
	postproc.o mergeclust.o newali.o djset.o clusttree.o taxmap.o sstack.o \
	spflagpool.o

OBJS := $(addprefix $(BINDIR)/,$(OBJNAMES))

EXTRA_OBJNAMES = @EXTRA_OBJS@
EXTRA_OBJS := $(addprefix $(BINDIR)/,$(EXTRA_OBJNAMES))

SELOBJNAMES = select.o memalloc.o plist.o hash.o namehash.o vararray.o
SELOBJS := $(addprefix $(BINDIR)/,$(SELOBJNAMES))
SPINDEXOBJS := $(BINDIR)/spindex.o

all:	$(BINDIR)/domclust

# object files are built into $(BINDIR), alongside the final binaries
$(BINDIR)/%.o:	$(SRCDIR)/%.c | $(BINDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BINDIR):
	@mkdir -p $(BINDIR)

$(BINDIR)/domclust:	$(OBJS) $(EXTRA_OBJS)
	$(CC) $(CFLAGS) $(OBJS) $(EXTRA_OBJS) -o $@ $(LIBS)

sptree:	$(BINDIR)/sptree

$(BINDIR)/sptree:	$(SRCDIR)/sptree.c $(SRCDIR)/plist.c $(SRCDIR)/namehash.c $(SRCDIR)/memalloc.c $(SRCDIR)/hash.c $(SRCDIR)/spec.c | $(BINDIR)
	$(CC) -g $^ -DDEBUGMAIN_SPTREE -o $@

install:	all
	$(INSTALL) -d $(DESTDIR)$(bindir)
	$(INSTALL_PROGRAM) $(BINDIR)/domclust $(DESTDIR)$(bindir)/domclust

uninstall:
	-rm -f $(DESTDIR)$(bindir)/domclust

clean:
	-rm -rf $(BINDIR)

select:	$(BINDIR)/select

$(BINDIR)/select:	$(SELOBJS)
	$(CC) $(CFLAGS) $(SELOBJS) -lgdbm -o $@

spindex:	$(BINDIR)/spindex

$(BINDIR)/spindex:	$(SPINDEXOBJS)
	$(CC) $(CFLAGS) $(SPINDEXOBJS) -lgdbm -o $@

blastconv:	$(BINDIR)/blastconv

$(BINDIR)/blastconv:	$(BINDIR)/blastconv.o
	$(CC) $(CFLAGS) $(BINDIR)/blastconv.o -o $@

test:	all
	cd tst;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test.in | \
		../Script/cmpr.pl -OVLPRATIO2=.2 -diff test.out -;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test2.in | \
		../Script/cmpr.pl -OVLPRATIO2=.2 -diff test2.out -;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test3.in | \
		../Script/cmpr.pl -OVLPRATIO2=.2 -diff test3.out -

testout:	all
	cd tst;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test.in > test.out;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test2.in > test2.out;\
	$(abspath $(BINDIR))/domclust stdin -S $(TESTOPT) < test3.in > test3.out

tarfile:
	tar cvf domclust.tar configure.ac Makefile.in $(SRCDIR)/*.c $(SRCDIR)/*.h Script tst build_input

distclean:	clean
	-rm -f Makefile config.log config.status
	-rm -rf autom4te.cache
